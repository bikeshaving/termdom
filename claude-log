  Automatic Re-rendering with MutationObserver

  class TOMRenderer {
    private document: Document;
    private observer: MutationObserver;
    private renderScheduled = false;

    constructor(document: Document) {
      this.document = document;
      this.setupMutationObserver();
    }

    private setupMutationObserver(): void {
      this.observer = new MutationObserver((mutations) => {
        this.scheduleRender();
      });

      // Watch everything that affects rendering
      this.observer.observe(this.document.body, {
        childList: true,        // appendChild/removeChild
        subtree: true,          // Changes in nested elements
        attributes: true,       // style changes, className, etc.
        attributeOldValue: true,
        characterData: true,    // textContent changes
        characterDataOldValue: true
      });
    }

    private scheduleRender(): void {
      if (this.renderScheduled) return;

      this.renderScheduled = true;

      // Batch renders using microtask queue
      queueMicrotask(() => {
        this.render();
        this.renderScheduled = false;
      });
    }

    private render(): void {
      // Only re-render what actually changed
      this.renderTree(this.document.body);
    }
  }

  Smart Mutation Handling

  class TOMRenderer {
    private setupMutationObserver(): void {
      this.observer = new MutationObserver((mutations) => {
        const changedElements = new Set<Element>();

        for (const mutation of mutations) {
          switch (mutation.type) {
            case 'childList':
              // Element added/removed - re-render parent
              if (mutation.target instanceof Element) {
                changedElements.add(mutation.target);
              }
              break;

            case 'attributes':
              // Style or attribute changed - re-render element
              if (mutation.target instanceof Element) {
                changedElements.add(mutation.target);
              }
              break;

            case 'characterData':
              // Text content changed - re-render parent element
              if (mutation.target.parentElement) {
                changedElements.add(mutation.target.parentElement);
              }
              break;
          }
        }

        this.scheduleRender(changedElements);
      });
    }

    private scheduleRender(changedElements: Set<Element>): void {
      // Batch multiple changes into single render
      queueMicrotask(() => {
        this.renderChangedElements(changedElements);
      });
    }
  }

