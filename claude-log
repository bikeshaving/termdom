  abstract class TOMNode {
    // DOM-compatible properties
    parentNode: TOMNode | null = null;
    childNodes: TOMNode[] = [];
    firstChild: TOMNode | null = null;
    lastChild: TOMNode | null = null;
    nextSibling: TOMNode | null = null;
    previousSibling: TOMNode | null = null;
    nodeName: string;
    nodeType: number;
    textContent: string | null = null;

    // DOM-compatible methods
    appendChild(child: TOMNode): TOMNode {
      this.childNodes.push(child);
      child.parentNode = this;
      this.updateSiblings();
      return child;
    }

    removeChild(child: TOMNode): TOMNode {
      const index = this.childNodes.indexOf(child);
      if (index !== -1) {
        this.childNodes.splice(index, 1);
        child.parentNode = null;
        this.updateSiblings();
      }
      return child;
    }

    insertBefore(newNode: TOMNode, referenceNode: TOMNode | null): TOMNode {
      if (!referenceNode) return this.appendChild(newNode);

      const index = this.childNodes.indexOf(referenceNode);
      this.childNodes.splice(index, 0, newNode);
      newNode.parentNode = this;
      this.updateSiblings();
      return newNode;
    }

    cloneNode(deep: boolean = false): TOMNode {
      // Implementation for cloning
    }

    contains(other: TOMNode): boolean {
      let current = other.parentNode;
      while (current) {
        if (current === this) return true;
        current = current.parentNode;
      }
      return false;
    }

    private updateSiblings(): void {
      this.firstChild = this.childNodes[0] || null;
      this.lastChild = this.childNodes[this.childNodes.length - 1] || null;

      for (let i = 0; i < this.childNodes.length; i++) {
        const child = this.childNodes[i];
        child.nextSibling = this.childNodes[i + 1] || null;
        child.previousSibling = this.childNodes[i - 1] || null;
      }
    }
  }

