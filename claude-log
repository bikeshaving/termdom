        inlineBoxes.push({
          element: child,
          minWidth: child.getMinContentWidth(),
          maxWidth: child.getMaxContentWidth()
        });
      }
    }

    // Phase 2: Build line boxes with wrapping
    const lineBoxes = buildLineBoxes(inlineBoxes, availableWidth);

    // Phase 3: Position elements within line boxes
    positionInlineElements(lineBoxes);
  }

