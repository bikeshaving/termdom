      // 1. Collect all matching CSS rules
      const matchingRules = this.getMatchingRules(element);

      // 2. Apply cascade and specificity
      const cascadedStyle = this.applyCascade(matchingRules);

      // 3. Convert to terminal-appropriate values
      const computedStyle = this.computeValues(cascadedStyle, element);

      // 4. Apply to Yoga layout
      this.applyToYoga(element.yogaNode, computedStyle);

      return computedStyle;
    }

    private computeValues(style: TMLStyle, element: TMLElement): ComputedTMLStyle {
      return {
        // Convert relative units to absolute
        width: this.resolveLength(style.width, element.parentElement?.computedStyle.width),
        height: this.resolveLength(style.height, element.parentElement?.computedStyle.height),

        // Resolve character units
        padding: style.padding.map(p => this.resolveCharacterUnit(p)),
        margin: style.margin.map(m => this.resolveCharacterUnit(m)),

