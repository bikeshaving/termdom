⏺ That's a brilliant idea! We could absolutely implement DOM-like APIs even outside the browser. The DOM is just an interface
  specification - there's no reason it has to be limited to HTML documents.

  What We Could Implement:

  Core DOM Node Interface

  abstract class TOMNode {
    // DOM-compatible properties
    parentNode: TOMNode | null = null;
    childNodes: TOMNode[] = [];
    firstChild: TOMNode | null = null;
    lastChild: TOMNode | null = null;
    nextSibling: TOMNode | null = null;
    previousSibling: TOMNode | null = null;
    nodeName: string;
    nodeType: number;
    textContent: string | null = null;

    // DOM-compatible methods
    appendChild(child: TOMNode): TOMNode {
      this.childNodes.push(child);
      child.parentNode = this;
      this.updateSiblings();
      return child;
    }

    removeChild(child: TOMNode): TOMNode {
      const index = this.childNodes.indexOf(child);
      if (index !== -1) {
        this.childNodes.splice(index, 1);
        child.parentNode = null;
        this.updateSiblings();
      }
      return child;
    }

    insertBefore(newNode: TOMNode, referenceNode: TOMNode | null): TOMNode {
      if (!referenceNode) return this.appendChild(newNode);

      const index = this.childNodes.indexOf(referenceNode);
      this.childNodes.splice(index, 0, newNode);
      newNode.parentNode = this;
      this.updateSiblings();
      return newNode;
    }

    cloneNode(deep: boolean = false): TOMNode {
      // Implementation for cloning
    }

    contains(other: TOMNode): boolean {
      let current = other.parentNode;
      while (current) {
        if (current === this) return true;
        current = current.parentNode;
      }
      return false;
    }

    private updateSiblings(): void {
      this.firstChild = this.childNodes[0] || null;
      this.lastChild = this.childNodes[this.childNodes.length - 1] || null;

      for (let i = 0; i < this.childNodes.length; i++) {
        const child = this.childNodes[i];
        child.nextSibling = this.childNodes[i + 1] || null;
        child.previousSibling = this.childNodes[i - 1] || null;
      }
    }
  }

  Element Interface with Selectors

  class TOMElement extends TOMNode {
    tagName: string;
    id: string = '';
    className: string = '';
    attributes: Map<string, string> = new Map();

    // DOM Element methods
    getAttribute(name: string): string | null {
      return this.attributes.get(name) || null;
    }

    setAttribute(name: string, value: string): void {
      this.attributes.set(name, value);
    }

    removeAttribute(name: string): void {
      this.attributes.delete(name);
    }

    hasAttribute(name: string): boolean {
      return this.attributes.has(name);
    }

    // CSS Selector methods
    querySelector(selector: string): TOMElement | null {
      return QueryEngine.querySelector(this, selector);
    }

    querySelectorAll(selector: string): TOMElement[] {
      return QueryEngine.querySelectorAll(this, selector);
    }

    getElementById(id: string): TOMElement | null {
      return this.querySelector(`#${id}`);
    }

    getElementsByTagName(tagName: string): TOMElement[] {
      return this.querySelectorAll(tagName);
    }

    getElementsByClassName(className: string): TOMElement[] {
      return this.querySelectorAll(`.${className}`);
    }

    matches(selector: string): boolean {
      return QueryEngine.matches(this, selector);
    }

    closest(selector: string): TOMElement | null {
      let current: TOMNode | null = this;
      while (current && current instanceof TOMElement) {
        if (current.matches(selector)) return current;
        current = current.parentNode;
      }
      return null;
    }
  }

  CSS Selector Engine

  class QueryEngine {
    static querySelector(root: TOMNode, selector: string): TOMElement | null {
      const results = this.querySelectorAll(root, selector);
      return results[0] || null;
    }

    static querySelectorAll(root: TOMNode, selector: string): TOMElement[] {
      const parser = new SelectorParser(selector);
      const selectors = parser.parse();
      const results: TOMElement[] = [];

      this.walkTree(root, (node) => {
        if (node instanceof TOMElement && this.matchesSelectors(node, selectors)) {
          results.push(node);
        }
      });

      return results;
    }

    static matches(element: TOMElement, selector: string): boolean {
      const parser = new SelectorParser(selector);
      const selectors = parser.parse();
      return this.matchesSelectors(element, selectors);
    }

    private static matchesSelectors(element: TOMElement, selectors: ParsedSelector[]): boolean {
      return selectors.some(selector => this.matchesSelector(element, selector));
    }

    private static matchesSelector(element: TOMElement, selector: ParsedSelector): boolean {
      // Check tag name
      if (selector.tagName && selector.tagName !== '*' &&
          element.tagName.toLowerCase() !== selector.tagName.toLowerCase()) {
        return false;
      }

      // Check ID
      if (selector.id && element.id !== selector.id) {
        return false;
      }

      // Check classes
      if (selector.classes.length > 0) {
        const elementClasses = element.className.split(/\s+/).filter(Boolean);
        for (const cls of selector.classes) {
          if (!elementClasses.includes(cls)) return false;
        }
      }

      // Check attributes
      for (const attr of selector.attributes) {
        if (!this.matchesAttribute(element, attr)) return false;
      }

      return true;
    }

    private static walkTree(node: TOMNode, callback: (node: TOMNode) => void): void {
      callback(node);
      for (const child of node.childNodes) {
        this.walkTree(child, callback);
      }
    }
  }

  interface ParsedSelector {
    tagName?: string;
    id?: string;
    classes: string[];
    attributes: AttributeSelector[];
  }

  interface AttributeSelector {
    name: string;
    operator?: '=' | '*=' | '^=' | '$=' | '~=' | '|=';
    value?: string;
  }

