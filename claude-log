> Well, if we create classes which extend Element but not HTMLElement/SVGElement, this happens automatically, right?


⏺ Yes, exactly! If we create our own element classes that extend the base Element class but not HTMLElement, we automatically
  bypass all the HTML/CSS-specific behavior.

  import { Window, Element } from 'happy-dom';

  // Our custom elements extend base Element, not HTMLElement
  class TOMElement extends Element {
    private _tomStyle: TOMStyle = {};

    get style(): TOMStyle {
      return this._tomStyle;
    }

    set style(value: TOMStyle) {
      this._tomStyle = { ...value };
      // Our style handling, no CSS involved
    }

    // All the DOM goodness, none of the HTML baggage
  }

  class TOMContainer extends TOMElement {
    constructor() {
      super();
      this.tagName = 'container';
    }
  }

  class TOMText extends TOMElement {
    constructor() {
      super();
      this.tagName = 'text';
    }
  }

  class TOMButton extends TOMElement {
    constructor() {
      super();
      this.tagName = 'button';
    }
  }

  Custom Element Registry

  class TOMDocument {
    private window: Window;
    private elementRegistry: Map<string, typeof TOMElement>;

    constructor() {
      this.window = new Window();
      this.elementRegistry = new Map();
      this.registerDefaultElements();

      // Override createElement to use our registry
      this.window.document.createElement = this.createElement.bind(this);
    }

    private registerDefaultElements(): void {
      this.elementRegistry.set('container', TOMContainer);
      this.elementRegistry.set('text', TOMText);
      this.elementRegistry.set('button', TOMButton);
    }

    createElement(tagName: string): TOMElement {
      const ElementClass = this.elementRegistry.get(tagName);
      if (!ElementClass) {
        throw new Error(`Unknown element: ${tagName}`);
      }

      const element = new ElementClass();
      element.ownerDocument = this.window.document;
      return element;
    }

    // Expose DOM APIs directly
    get body() { return this.window.document.body; }
    querySelector = this.window.document.querySelector.bind(this.window.document);
    getElementById = this.window.document.getElementById.bind(this.window.document);
    addEventListener = this.window.document.addEventListener.bind(this.window.document);
  }

  What This Gets Us

  // Clean inheritance hierarchy
  Element (from HappyDOM)
  ├── Node manipulation (appendChild, removeChild)
  ├── Event handling (addEventListener)
  ├── Tree traversal (parentNode, firstChild)
  ├── Query support (matches, closest)
  └── NO HTML/CSS baggage

  TOMElement extends Element
  ├── Custom style system (TOMStyle objects)
  ├── Terminal-specific properties
  ├── Custom rendering logic
  └── Clean slate for terminal UI

  Usage

  const doc = new TOMDocument();

  // Creates TOMContainer instance, not HTMLDivElement
  const container = doc.createElement('container');
  container.style = { display: 'flex', padding: 2 };

  // Creates TOMText instance, not HTMLSpanElement
  const text = doc.createElement('text');
  text.textContent = 'Hello Terminal!';
  text.style = { color: 'blue' };

  // All DOM methods work
  container.appendChild(text);
  doc.body.appendChild(container);

  // Query selectors work
  const buttons = doc.querySelectorAll('button');
  const firstContainer = doc.querySelector('container');

