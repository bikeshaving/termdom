  class TOMDocument {
    private dom: JSDOM;
    private document: Document;
    private elementMap = new WeakMap<Element, TOMRenderData>();

    constructor() {
      this.dom = new JSDOM();
      this.document = this.dom.window.document;
    }

    createElement(tagName: string): Element {
      const element = this.document.createElement(tagName);

      // Attach TOM-specific data
      this.elementMap.set(element, {
        style: {},
        bounds: new Rect(0, 0, 0, 0),
        buffer: null,
        needsRender: true
      });

      return element;
    }

    render(): void {
      // Walk DOM tree and render using attached data
      const walker = this.document.createTreeWalker(
        this.document.body,
        NodeFilter.SHOW_ELEMENT
      );

      let node;
      while (node = walker.nextNode()) {
        const tomData = this.elementMap.get(node as Element);
        if (tomData) {
          this.renderElement(node as Element, tomData);
        }
      }
    }
