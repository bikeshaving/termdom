  function parseSize(value: string, viewport: { width: number, height: number }) {
    if (value.endsWith('vw')) return (parseFloat(value) / 100) * viewport.width;
    if (value.endsWith('vh')) return (parseFloat(value) / 100) * viewport.height;
    if (value.endsWith('%')) return parseFloat(value); // Relative to parent
    if (value.endsWith('ch')) return parseFloat(value); // Character cells
    return parseFloat(value); // Unitless cells
