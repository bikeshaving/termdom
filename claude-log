  // tail -f tom-debug.log

  2. stderr Redirection

  # Run app and redirect debug output to another terminal
  bun mouse-demo.ts 2> debug.txt

  # Or in tmux/screen, pipe stderr to another pane
  bun mouse-demo.ts 2>&1 | tee /dev/pts/1  # pts/1 = another terminal

  3. In-App Debug Panel (What I just built)

  // Add debug panel to your TOM app
  const debugPanel = new TOMDebugPanel();
  document.body.appendChild(debugPanel);

  // Log without corrupting main display
  debugPanel.log('Mouse click at', x, y);
  debugPanel.log('Element found:', element.tagName);

  4. Network Debugging (Advanced)

  // Send debug info to external service
  fetch('http://localhost:3001/debug', {
    method: 'POST',
    body: JSON.stringify({ event: 'click', x, y })
  });

  5. State Snapshots

  // Dump state to file at key moments
  writeFileSync('mouse-state.json', JSON.stringify({
    mouseState: this.mouseState,
    elementBounds: element.bounds,
    timestamp: Date.now()
  }, null, 2));

  6. Visual Debug Overlays

  // Add visual indicators directly in the UI
  const debugDot = tom.createElement('text');
  debugDot.textContent = '●';
  debugDot.style.position = 'absolute';
  debugDot.style.left = mouseX;
  debugDot.style.top = mouseY;
