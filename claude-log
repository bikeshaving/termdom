  class TOMRenderer {
    private setupMutationObserver(): void {
      this.observer = new MutationObserver((mutations) => {
        const changedElements = new Set<Element>();

        for (const mutation of mutations) {
          switch (mutation.type) {
            case 'childList':
              // Element added/removed - re-render parent
              if (mutation.target instanceof Element) {
                changedElements.add(mutation.target);
              }
              break;

            case 'attributes':
              // Style or attribute changed - re-render element
              if (mutation.target instanceof Element) {
                changedElements.add(mutation.target);
              }
              break;

            case 'characterData':
              // Text content changed - re-render parent element
              if (mutation.target.parentElement) {
                changedElements.add(mutation.target.parentElement);
              }
              break;
          }
        }

        this.scheduleRender(changedElements);
      });
    }

    private scheduleRender(changedElements: Set<Element>): void {
      // Batch multiple changes into single render
      queueMicrotask(() => {
        this.renderChangedElements(changedElements);
      });
    }
