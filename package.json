{
  "name": "@b9g/termdom",
  "version": "0.1.5",
  "description": "HTML, CSS and the DOM for terminal emulators. Real CSS layout, no native or WASM dependency.",
  "license": "MIT",
  "author": "Brian Kim",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bikeshaving/termdom.git"
  },
  "homepage": "https://github.com/bikeshaving/termdom#readme",
  "bugs": {
    "url": "https://github.com/bikeshaving/termdom/issues"
  },
  "type": "module",
  "keywords": [
    "terminal",
    "tui",
    "cli",
    "ansi",
    "dom",
    "css",
    "flexbox",
    "layout"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./index": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./index.js": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./dist/package.json"
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.cjs",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "libuild build",
    "lint": "eslint .",
    "prepublishOnly": "echo 'ERROR: Cannot publish from root directory. Use libuild publish instead.' && exit 1",
    "smoke": "node scripts/smoke.js",
    "smoke:deno": "deno run -A --node-modules-dir=manual scripts/smoke.js",
    "support": "bun scripts/support-matrix.ts",
    "test": "libuild test -p node -p bun",
    "typecheck": "tsc --noEmit",
    "verify:examples": "node scripts/verify-examples.ts",
    "verify:ime": "npm --prefix website run verify:ime",
    "verify:terminal": "node scripts/verify-terminal-app.ts",
    "verify:tmux": "node scripts/verify-tmux.ts"
  },
  "dependencies": {
    "arabic-persian-reshaper": "1.0.1",
    "bidi-js": "1.0.3",
    "css-tree": "^3.2.1",
    "linebreak": "1.1.0",
    "nwsapi": "^2.2.21",
    "parse5": "^7.3.0"
  },
  "devDependencies": {
    "@b9g/crank": "^0.7.11",
    "@b9g/eslint-config": "^0.1.0",
    "@b9g/libuild": "^0.2.22",
    "@eslint/js": "^9.39.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/prismjs": "^1.26.6",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@xterm/headless": "^5.5.0",
    "eslint": "^9.39.5",
    "eslint-plugin-acrocase": "^0.1.1",
    "eslint-plugin-crank": "^0.2.2",
    "eslint-plugin-esfold": "^0.1.0",
    "fast-check": "^4.9.0",
    "htm": "^3.1.1",
    "marked": "^18.0.9",
    "marked-highlight": "^2.2.4",
    "mdn-data": "2.29.0",
    "prismjs": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "svelte": "^5.56.9",
    "typescript": "^5.9.2",
    "vue": "^3.5.41"
  },
  "module": "./dist/index.js",
  "engines": {
    "node": ">=20.0.0"
  }
}
