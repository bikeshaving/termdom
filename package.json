{
  "name": "@b9g/termdom",
  "version": "0.1.8",
  "description": "HTML, CSS and DOM for terminal emulators.",
  "license": "MIT",
  "author": "Brian Kim",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bikeshaving/termdom.git"
  },
  "homepage": "https://termdom.org",
  "bugs": {
    "url": "https://github.com/bikeshaving/termdom/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "keywords": [
    "terminal",
    "tui",
    "cli",
    "ansi",
    "dom",
    "css",
    "flexbox",
    "layout"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "libuild build",
    "lint": "eslint .",
    "prepublishOnly": "echo 'ERROR: Cannot publish from root directory. Use libuild to publish or stage the package.' && exit 1",
    "smoke": "node scripts/smoke.js",
    "smoke:deno": "deno run -A --node-modules-dir=manual scripts/smoke.js",
    "support": "bun scripts/support-matrix.ts",
    "test": "libuild test -p node -p bun -p deno --timeout 180000",
    "typecheck": "tsc --noEmit",
    "drift": "bun scripts/lib-dom-drift.ts",
    "verify:examples": "node scripts/verify-examples.ts",
    "verify:ime": "npm --prefix website run verify:ime",
    "verify:terminal": "node scripts/verify-terminal-app.ts",
    "verify:tmux": "node scripts/verify-tmux.ts"
  },
  "dependencies": {
    "arabic-persian-reshaper": "1.0.1",
    "bidi-js": "1.0.3",
    "css-tree": "^3.2.1",
    "linebreak": "1.1.0",
    "parse5": "^7.3.0"
  },
  "devDependencies": {
    "@b9g/crank": "^0.7.12",
    "@b9g/eslint-config": "^0.1.10",
    "@b9g/libuild": "^0.2.25",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@eslint/js": "^9.39.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.13.6",
    "@types/prismjs": "^1.26.6",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@webref/elements": "^2.9.0",
    "@webref/idl": "^3.84.0",
    "@xterm/headless": "^5.5.0",
    "codemirror": "^6.0.2",
    "eslint": "^9.39.5",
    "eslint-plugin-acrocase": "^0.1.1",
    "eslint-plugin-crank": "^0.2.2",
    "eslint-plugin-esfold": "^0.1.14",
    "fast-check": "^4.10.2",
    "htm": "^3.1.1",
    "katex": "^0.18.9",
    "marked": "^18.0.14",
    "marked-highlight": "^2.2.4",
    "mdn-data": "2.29.0",
    "prismjs": "^1.30.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ssh2": "^1.17.0",
    "svelte": "^5.57.1",
    "typescript": "^5.9.3",
    "vue": "^3.5.43",
    "webidl2": "^24.5.0"
  },
  "module": "./dist/index.js",
  "engines": {
    "node": ">=20.0.0"
  }
}
