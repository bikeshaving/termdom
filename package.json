{
	"name": "@b9g/termdom",
	"version": "0.1.2",
	"description": "HTML, CSS and the DOM for terminal emulators. Real CSS layout, no native or WASM dependency.",
	"license": "MIT",
	"author": "Brian Kim",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bikeshaving/termdom.git"
	},
	"homepage": "https://github.com/bikeshaving/termdom#readme",
	"bugs": {
		"url": "https://github.com/bikeshaving/termdom/issues"
	},
	"type": "module",
	"keywords": [
		"terminal",
		"tui",
		"cli",
		"ansi",
		"dom",
		"css",
		"flexbox",
		"layout"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs",
			"default": "./dist/index.js"
		},
		"./index": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./index.js": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./package.json": "./dist/package.json"
	},
	"types": "./dist/index.d.ts",
	"main": "./dist/index.cjs",
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "libuild build",
		"lint": "eslint --ext .js,.jsx,.ts,.tsx .",
		"smoke": "node scripts/smoke.mjs",
		"smoke:deno": "deno run -A --node-modules-dir=manual scripts/smoke.mjs",
		"support": "bun scripts/support-matrix.ts",
		"test": "libuild test -p node -p bun",
		"typecheck": "tsc --noEmit",
		"verify:tmux": "node scripts/verify-tmux.ts",
		"verify:terminal": "node scripts/verify-terminal-app.ts",
		"prepublishOnly": "echo 'ERROR: Cannot publish from root directory. Use libuild publish instead.' && exit 1",
		"verify:examples": "node scripts/verify-examples.ts"
	},
	"dependencies": {
		"arabic-persian-reshaper": "1.0.1",
		"bidi-js": "1.0.3",
		"css-tree": "^3.2.1",
		"linebreak": "1.1.0",
		"nwsapi": "^2.2.21",
		"parse5": "^7.3.0"
	},
	"devDependencies": {
		"@b9g/crank": "^0.7.1",
		"@b9g/libuild": "^0.2.16",
		"@tanstack/table-core": "^8.21.3",
		"@types/bun": "^1.2.21",
		"@types/prismjs": "^1.26.6",
		"@typescript-eslint/eslint-plugin": "^8.29.1",
		"@typescript-eslint/parser": "^8.29.1",
		"@xterm/headless": "^5.5.0",
		"eslint": "^8.57.1",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-prettier": "^5.2.6",
		"fast-check": "^4.9.0",
		"marked": "^18.0.9",
		"marked-highlight": "^2.2.4",
		"mdn-data": "2.29.0",
		"prismjs": "^1.30.0",
		"typescript": "^5.9.2"
	},
	"module": "./dist/index.js"
}
