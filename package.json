{
  "name": "@b9g/termdom",
	"version": "0.1.0-beta.0",
  "description": "HTML, CSS and the DOM for terminal emulators. Real CSS layout, no native or WASM dependency.",
  "license": "MIT",
  "author": "Brian Kim",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bikeshaving/termdom.git"
  },
  "homepage": "https://github.com/bikeshaving/termdom#readme",
  "bugs": {
    "url": "https://github.com/bikeshaving/termdom/issues"
  },
  "type": "module",
  "keywords": [
    "terminal",
    "tui",
    "cli",
    "ansi",
    "dom",
    "css",
    "flexbox",
    "layout"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LAYOUT.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx .",
    "smoke": "node scripts/smoke.mjs",
    "smoke:deno": "deno run -A --node-modules-dir=manual scripts/smoke.mjs",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cssstyle": "^5.2.1",
    "jsdom": "^26.1.0",
    "linebreak": "^1.1.0"
  },
  "devDependencies": {
    "@b9g/crank": "^0.7.1",
    "@tanstack/table-core": "^8.21.3",
    "@types/bun": "^1.2.21",
    "@types/cssstyle": "^2.2.4",
    "@types/jsdom": "^21.1.7",
    "@typescript-eslint/eslint-plugin": "^8.29.1",
    "@typescript-eslint/parser": "^8.29.1",
    "@xterm/headless": "^5.5.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.6",
    "fast-check": "^4.2.0",
    "typescript": "^5.9.2"
  }
}
