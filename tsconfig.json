{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["es2022", "es2022.intl", "dom"],
    "target": "es2022",
    "module": "esnext",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "jsxImportSource": "@b9g/crank",

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,

    // Examples import the package by name, as a user would -- resolve that to
    // the source so `tsc --noEmit` is hermetic and needs no built dist (the
    // exports map points types at dist/, which a fresh checkout has not built).
    "paths": {
      "@b9g/termdom": ["./src/index.ts"]
    },
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices - strict mode
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true
  },
  "include": ["src", "tests", "examples", "scripts"]
}
