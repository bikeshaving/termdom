{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["es2022", "es2022.intl", "dom", "DOM.Iterable"],
    "target": "es2022",
    "module": "esnext",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "jsxImportSource": "@b9g/crank",

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,

    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices - strict mode
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true
  },
  "include": ["src", "tests", "fuzz", "examples", "scripts"],
	// The drift ledger instantiates every class against lib.dom, which is
	// sixty seconds and three gigabytes the ordinary typecheck does not need.
	// scripts/lib-dom-drift.ts checks it in a program of its own.
	"exclude": ["scripts/lib-dom-exact.ts"]
}
