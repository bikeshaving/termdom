{
  "env": {
    "browser": true,
    "commonjs": true,
    "es6": true,
    "node": true
  },
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "sourceType": "module",
    "createDefaultProgram": true
  },
  "plugins": ["@typescript-eslint", "prettier"],
  "extends": ["eslint:recommended", "plugin:prettier/recommended"],
  "overrides": [
    {
      "files": ["examples/**/*.ts", "scripts/**/*.ts"],
      "rules": {
        "no-console": "off"
      }
    }
  ],
  "rules": {
    "no-console": [
      "error",
      {
        "allow": ["info", "warn", "error"]
      }
    ],
    "no-unused-vars": 0,
    "@typescript-eslint/no-unused-vars": [
      "error",
      {
        "varsIgnorePattern": "^_",
        "argsIgnorePattern": "^_",
        "caughtErrors": "none"
      }
    ],
    "no-dupe-class-members": 0,
    "@typescript-eslint/no-dupe-class-members": 1,
    "no-undef": 0,
    "no-redeclare": 0,
    "prettier/prettier": [
      "error",
      {
        "trailingComma": "all",
        "arrowParens": "always",
        "useTabs": true,
        "bracketSpacing": false
      }
    ],
    "linebreak-style": ["error", "unix"],
    "no-control-regex": "off",
    "@typescript-eslint/array-type": ["error", { "default": "array-simple" }],
    "no-restricted-syntax": [
      "error",
      {
        "selector": "TSParameterProperty",
        "message": "Parameter properties are banned. Declare a #private field and assign it in the constructor."
      },
      {
        "selector": ":matches(PropertyDefinition, MethodDefinition, TSAbstractPropertyDefinition, TSAbstractMethodDefinition)[accessibility]",
        "message": "TypeScript access modifiers (public/private/protected) are banned. Use #private for internals, or omit the modifier for public members."
      },
      {
        "selector": ":matches(Program, ExportNamedDeclaration, ExportDefaultDeclaration) > VariableDeclaration > VariableDeclarator > :matches(ArrowFunctionExpression[body.type='BlockStatement'][body.body.length>0], FunctionExpression)",
        "message": "Declare multi-statement top-level functions with `function`. Arrows are for one-liners like `const noop = () => {};`."
      }
    ]
  }
}
