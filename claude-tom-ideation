  class TOMRenderer {
    private renderChangedElements(changedElements: Set<Element>): void {
      // 1. Calculate affected layout regions
      const layoutRegions = this.calculateLayoutRegions(changedElements);

      // 2. Only re-layout affected regions
      for (const region of layoutRegions) {
        this.layoutEngine.computeLayout(region);
      }

      // 3. Only re-render visual changes
      for (const element of changedElements) {
        this.renderElement(element);
      }

      // 4. Batch screen buffer updates
      this.screenBuffer.commitChanges();
    }

    private calculateLayoutRegions(changed: Set<Element>): Set<Element> {
      const regions = new Set<Element>();

      for (const element of changed) {
        // Find nearest layout container that needs recalculation
        let current = element;
        while (current && !this.isLayoutContainer(current)) {
          current = current.parentElement;
        }
        if (current) regions.add(current);
      }

      return regions;
    }
