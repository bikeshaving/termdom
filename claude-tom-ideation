  Option 1: DOM as Structure, Custom Rendering

  import { JSDOM } from 'jsdom';

  class TOMRenderer {
    private dom: JSDOM;
    private document: Document;
    private rootBuffer: ScreenBuffer;

    constructor() {
      this.dom = new JSDOM('<!DOCTYPE html><html><body></body></html>');
      this.document = this.dom.window.document;
      this.rootBuffer = new ScreenBuffer(80, 24);

      // Map DOM events to terminal events
      this.setupEventBridge();
    }

    // Create TOM-specific elements that extend DOM elements
    createElement(tagName: string): TOMElement {
      const element = this.document.createElement(tagName) as TOMElement;

      // Add TOM-specific properties
      element.tomStyle = {};
      element.tomBounds = new Rect(0, 0, 0, 0);
      element.tomBuffer = null;

      // Override render method
      element.render = this.renderElement.bind(this, element);

      return element;
    }

    private renderElement(element: TOMElement): void {
      // Convert DOM element to terminal rendering
      const style = this.computeStyle(element);
      const bounds = this.computeLayout(element);

      if (element.tagName === 'DIV' || element.tagName === 'CONTAINER') {
        this.renderContainer(element, style, bounds);
      } else if (element.tagName === 'SPAN' || element.tagName === 'TEXT') {
        this.renderText(element, style, bounds);
      }
      // etc...
    }

    render(): void {
      // Use DOM tree traversal
      this.walkTree(this.document.body, (element) => {
        if (element.nodeType === 1) { // ELEMENT_NODE
          this.renderElement(element as TOMElement);
        }
      });

      this.rootBuffer.render();
    }
  }

