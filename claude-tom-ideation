  Event Handling on Nodes:

  abstract class TUINode {
    private eventListeners = new Map<string, Function[]>();

    addEventListener<K extends keyof TUIEventMap>(
      type: K,
      listener: (event: TUIEventMap[K]) => void
    ) {
      if (!this.eventListeners.has(type)) {
        this.eventListeners.set(type, []);
      }
      this.eventListeners.get(type)!.push(listener);
    }

    removeEventListener<K extends keyof TUIEventMap>(
      type: K,
      listener: (event: TUIEventMap[K]) => void
    ) {
      const listeners = this.eventListeners.get(type);
      if (listeners) {
        const index = listeners.indexOf(listener);
        if (index > -1) listeners.splice(index, 1);
      }
    }

    dispatchEvent(event: TUIEvent): boolean {
      event.target = this;

      // Bubble up the tree
      let currentTarget = this as TUINode | undefined;

      while (currentTarget && !event.stopPropagation) {
        event.currentTarget = currentTarget;

        const listeners = currentTarget.eventListeners.get(event.type);
        if (listeners) {
          for (const listener of listeners) {
            listener(event);
            if (event.stopPropagation) break;
          }
        }

        currentTarget = currentTarget.parent;
      }

      return !event.defaultPrevented;
    }
  }

  Input Capture & Dispatching:

  class TUIEventManager {
    private root: TUINode;
    private focusedElement: TUINode | null = null;

    constructor(root: TUINode) {
      this.root = root;
      this.setupInputCapture();
    }

    private setupInputCapture() {
      // Capture stdin for keyboard events
      process.stdin.setRawMode(true);
      process.stdin.on('data', this.handleInput.bind(this));

      // Setup mouse capture if terminal supports it
      process.stdout.write('\x1b[?1003h'); // Enable mouse tracking
    }

    private handleInput(buffer: Buffer) {
      const input = buffer.toString();

      if (this.isMouseInput(input)) {
        this.handleMouseInput(input);
      } else {
        this.handleKeyboardInput(input);
      }
    }

    private handleKeyboardInput(input: string) {
      const event = new KeyboardEvent(this.parseKey(input));

      // Send to focused element or root
      const target = this.focusedElement || this.root;
      target.dispatchEvent(event);
    }

    private handleMouseInput(input: string) {
      const {x, y, button} = this.parseMouseInput(input);

      // Hit test to find target element
      const target = this.hitTest(x, y);

      const event = new MouseEvent(x, y, button);
      target?.dispatchEvent(event);
    }

    private hitTest(x: number, y: number): TUINode | null {
      // Walk the tree to find which element contains this point
      return this.hitTestRecursive(this.root, x, y);
    }

    private hitTestRecursive(node: TUINode, x: number, y: number): TUINode | null {
      // Check if point is within node bounds
      if (!node.bounds.contains(x, y)) return null;

      // Check children first (front to back)
      for (const child of [...node.children].reverse()) {
        const hit = this.hitTestRecursive(child, x, y);
        if (hit) return hit;
      }

      return node;
    }
  }

