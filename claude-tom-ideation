  class TMLStyleEngine {
    private cssParser: CSSParser;
    private yoga: Yoga;

    constructor() {
      this.cssParser = new CSSParser();
      this.yoga = new Yoga();
    }

    parseStylesheet(css: string): TMLStylesheet {
      const ast = this.cssParser.parse(css);
      return this.transformToTML(ast);
    }

    computeStyle(element: TMLElement): ComputedTMLStyle {
      // 1. Collect all matching CSS rules
      const matchingRules = this.getMatchingRules(element);

      // 2. Apply cascade and specificity
      const cascadedStyle = this.applyCascade(matchingRules);

      // 3. Convert to terminal-appropriate values
      const computedStyle = this.computeValues(cascadedStyle, element);

      // 4. Apply to Yoga layout
      this.applyToYoga(element.yogaNode, computedStyle);

      return computedStyle;
    }

    private computeValues(style: TMLStyle, element: TMLElement): ComputedTMLStyle {
      return {
        // Convert relative units to absolute
        width: this.resolveLength(style.width, element.parentElement?.computedStyle.width),
        height: this.resolveLength(style.height, element.parentElement?.computedStyle.height),

        // Resolve character units
        padding: style.padding.map(p => this.resolveCharacterUnit(p)),
        margin: style.margin.map(m => this.resolveCharacterUnit(m)),

        // Resolve terminal colors
        color: this.resolveColor(style.color),
        backgroundColor: this.resolveColor(style.backgroundColor),

        // Terminal-specific computations
        boxDrawing: this.resolveBoxDrawing(style.boxDrawing),
        cursorStyle: style.cursorStyle || 'block'
      };
    }

    private resolveCharacterUnit(value: string): number {
      if (value.endsWith('ch')) {
        return parseFloat(value) * this.characterWidth;
      }
      if (value.endsWith('lh')) {
        return parseFloat(value) * this.lineHeight;
      }
      return parseFloat(value);
    }

    private resolveColor(color: string): ANSIColor {
      // Use Bun.color to convert any CSS color to ANSI
      return Bun.color(color, 'ansi') || '';
    }
  }

