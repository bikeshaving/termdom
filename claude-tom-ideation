  Implementation Strategy

  create({tag, props}) {
    if (tag === 'Container') {
      // Calculate effective positioning with box model
      const {
        contentX,
        contentY,
        contentWidth,
        contentHeight
      } = calculateBoxModel(props);

      // Create border if specified
      if (props.border) {
        new termkit.Border({
          parent: parent,
          x: props.x,
          y: props.y,
          width: props.width,
          height: props.height,
          borderChars: props.border
        });
      }

      // Create container for content
      return new termkit.Container({
        parent: parent,
        x: contentX,      // Adjusted for margin + border + padding
        y: contentY,
        width: contentWidth,
        height: contentHeight
      });
    }
  }

  function calculateBoxModel(props) {
    const margin = extractSpacing(props.margin);
    const border = props.border ? 1 : 0;
    const padding = extractSpacing(props.padding);

    return {
      contentX: props.x + margin.left + border + padding.left,
      contentY: props.y + margin.top + border + padding.top,
      contentWidth: props.width - margin.horizontal - border*2 - padding.horizontal,
      contentHeight: props.height - margin.vertical - border*2 - padding.vertical
    };
  }

