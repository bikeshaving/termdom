  CSS Selector Engine

  class QueryEngine {
    static querySelector(root: TOMNode, selector: string): TOMElement | null {
      const results = this.querySelectorAll(root, selector);
      return results[0] || null;
    }

    static querySelectorAll(root: TOMNode, selector: string): TOMElement[] {
      const parser = new SelectorParser(selector);
      const selectors = parser.parse();
      const results: TOMElement[] = [];

      this.walkTree(root, (node) => {
        if (node instanceof TOMElement && this.matchesSelectors(node, selectors)) {
          results.push(node);
        }
      });

      return results;
    }

    static matches(element: TOMElement, selector: string): boolean {
      const parser = new SelectorParser(selector);
      const selectors = parser.parse();
      return this.matchesSelectors(element, selectors);
    }

    private static matchesSelectors(element: TOMElement, selectors: ParsedSelector[]): boolean {
      return selectors.some(selector => this.matchesSelector(element, selector));
    }

    private static matchesSelector(element: TOMElement, selector: ParsedSelector): boolean {
      // Check tag name
      if (selector.tagName && selector.tagName !== '*' &&
          element.tagName.toLowerCase() !== selector.tagName.toLowerCase()) {
        return false;
      }

      // Check ID
      if (selector.id && element.id !== selector.id) {
        return false;
      }

      // Check classes
      if (selector.classes.length > 0) {
        const elementClasses = element.className.split(/\s+/).filter(Boolean);
        for (const cls of selector.classes) {
          if (!elementClasses.includes(cls)) return false;
        }
      }

      // Check attributes
      for (const attr of selector.attributes) {
        if (!this.matchesAttribute(element, attr)) return false;
      }

      return true;
    }

    private static walkTree(node: TOMNode, callback: (node: TOMNode) => void): void {
      callback(node);
      for (const child of node.childNodes) {
        this.walkTree(child, callback);
      }
    }
  }

  interface ParsedSelector {
    tagName?: string;
    id?: string;
    classes: string[];
    attributes: AttributeSelector[];
  }

  interface AttributeSelector {
    name: string;
    operator?: '=' | '*=' | '^=' | '$=' | '~=' | '|=';
    value?: string;
  }

