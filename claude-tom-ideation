        set(value) { this._tomStyle = value; }
      });

      // Disable CSS parsing
      document.createElement = (tagName: string) => {
        const element = this.window.document.createElement.call(this, tagName);
        element._tomStyle = {}; // Our style object
        return element;
      };
    }

    private setupCustomStyling(): void {
      // Our simple styling system
      this.cssEngine.onStyleChange = (element, newStyle) => {
        // Trigger layout/render when styles change
        this.scheduleRender();
      };
    }
  }

  Custom Style System

  interface TOMStyle {
    // Layout
    display?: 'flex' | 'block' | 'none';
    flexDirection?: 'row' | 'column';
    justifyContent?: 'flex-start' | 'center' | 'flex-end';

    // Box model (character units)
    width?: number | string;
    height?: number | string;
    padding?: number;
    margin?: number;

    // Terminal styling
    color?: string;
    backgroundColor?: string;
    fontWeight?: 'normal' | 'bold';
    fontStyle?: 'normal' | 'italic';
  }

  class TOMStyleEngine {
    applyStyle(element: Element, style: TOMStyle): void {
      // Store style on element
      (element as any)._tomStyle = { ...style };

      // Apply to Yoga for layout
      this.applyToYoga(element, style);

      // Trigger re-render
      this.onStyleChange?.(element, style);
    }

    getComputedStyle(element: Element): TOMStyle {
      return (element as any)._tomStyle || {};
    }

    private applyToYoga(element: Element, style: TOMStyle): void {
      const yogaNode = this.getYogaNode(element);

      if (style.display) {
        yogaNode.setDisplay(this.mapDisplay(style.display));
      }
      if (style.flexDirection) {
        yogaNode.setFlexDirection(this.mapFlexDirection(style.flexDirection));
      }
      // etc...
    }
  }

  Clean Element Interface

  class TOMElement extends HTMLElement {
    private _tomStyle: TOMStyle = {};

    get style(): TOMStyle {
      return this._tomStyle;
    }

    set style(value: TOMStyle) {
      this._tomStyle = { ...value };
      tomStyleEngine.applyStyle(this, this._tomStyle);
    }

    // Override setAttribute to handle style changes
    setAttribute(name: string, value: string): void {
      super.setAttribute(name, value);

      if (name === 'class') {
        // Could apply class-based styles here
        this.applyClassStyles();
      }
    }
  }

  What We Get vs Skip

  ✅ Use from HappyDOM:

  - DOM tree structure (parent/child relationships)
  - Event system (addEventListener, bubbling)
  - Query selectors (querySelector, getElementById)
  - Node manipulation (appendChild, removeChild)
  - MutationObserver
  - TreeWalker, NodeIterator

  ❌ Skip from HappyDOM:

  - CSS parsing engine
  - CSS cascade/specificity
  - CSS selectors for styling (we still use them for querying)
  - CSSOM (CSSStyleSheet, etc.)
  - CSS animations/transitions
  - Media queries

  🔧 Replace with our own:

  - Simple style objects instead of CSS strings
  - Yoga for layout instead of CSS layout
  - Terminal-specific style properties
  - Bun.color for color processing

  Usage Example

  // HappyDOM handles the tree, we handle styling
  const document = new TOMDocument();

  const container = document.createElement('container');
  container.style = {  // Our simple style object
    display: 'flex',
    flexDirection: 'column',
    padding: 2,
    backgroundColor: 'blue'
  };

  const text = document.createElement('text');
  text.textContent = 'Hello!';
  text.style = {  // Not CSS strings, just objects
    color: 'white',
    fontWeight: 'bold'
  };

  container.appendChild(text);  // HappyDOM handles tree manipulation
  document.body.appendChild(container);

  // MutationObserver (from HappyDOM) triggers our renderer

  This gives us the best of both worlds:
  - Mature DOM implementation from HappyDOM
  - Simple, terminal-focused styling system from us
  - No CSS complexity we don't need
  - Full control over the styling behavior

  Perfect separation of concerns! 🎯


> Well, if we create classes which extend Element but not HTMLElement/SVGElement, this happens automatically, right?


⏺ Yes, exactly! If we create our own element classes that extend the base Element class but not HTMLElement, we automatically
  bypass all the HTML/CSS-specific behavior.

  import { Window, Element } from 'happy-dom';

  // Our custom elements extend base Element, not HTMLElement
  class TOMElement extends Element {
    private _tomStyle: TOMStyle = {};

    get style(): TOMStyle {
      return this._tomStyle;
    }

    set style(value: TOMStyle) {
      this._tomStyle = { ...value };
      // Our style handling, no CSS involved
    }

    // All the DOM goodness, none of the HTML baggage
  }

  class TOMContainer extends TOMElement {
    constructor() {
      super();
      this.tagName = 'container';
    }
  }

  class TOMText extends TOMElement {
    constructor() {
      super();
      this.tagName = 'text';
    }
  }

  class TOMButton extends TOMElement {
    constructor() {
      super();
      this.tagName = 'button';
    }
  }

  Custom Element Registry

  class TOMDocument {
    private window: Window;
    private elementRegistry: Map<string, typeof TOMElement>;

    constructor() {
      this.window = new Window();
      this.elementRegistry = new Map();
      this.registerDefaultElements();

      // Override createElement to use our registry
      this.window.document.createElement = this.createElement.bind(this);
    }

    private registerDefaultElements(): void {
      this.elementRegistry.set('container', TOMContainer);
      this.elementRegistry.set('text', TOMText);
      this.elementRegistry.set('button', TOMButton);
    }

    createElement(tagName: string): TOMElement {
      const ElementClass = this.elementRegistry.get(tagName);
      if (!ElementClass) {
        throw new Error(`Unknown element: ${tagName}`);
      }

      const element = new ElementClass();
      element.ownerDocument = this.window.document;
      return element;
    }

    // Expose DOM APIs directly
    get body() { return this.window.document.body; }
    querySelector = this.window.document.querySelector.bind(this.window.document);
    getElementById = this.window.document.getElementById.bind(this.window.document);
    addEventListener = this.window.document.addEventListener.bind(this.window.document);
  }

  What This Gets Us

  // Clean inheritance hierarchy
  Element (from HappyDOM)
  ├── Node manipulation (appendChild, removeChild)
  ├── Event handling (addEventListener)
  ├── Tree traversal (parentNode, firstChild)
  ├── Query support (matches, closest)
  └── NO HTML/CSS baggage

  TOMElement extends Element
  ├── Custom style system (TOMStyle objects)
  ├── Terminal-specific properties
  ├── Custom rendering logic
  └── Clean slate for terminal UI

  Usage

  const doc = new TOMDocument();

  // Creates TOMContainer instance, not HTMLDivElement
  const container = doc.createElement('container');
  container.style = { display: 'flex', padding: 2 };

  // Creates TOMText instance, not HTMLSpanElement
  const text = doc.createElement('text');
  text.textContent = 'Hello Terminal!';
  text.style = { color: 'blue' };

  // All DOM methods work
  container.appendChild(text);
  doc.body.appendChild(container);

  // Query selectors work
  const buttons = doc.querySelectorAll('button');
  const firstContainer = doc.querySelector('container');

  This approach is much cleaner because:

  ✅ No CSS pollution - HTMLElement comes with tons of CSS baggage✅ Clean slate - We define exactly what properties exist✅ Type
  safety - TypeScript knows these are TOM elements✅ No conflicts - Can't accidentally use HTML-specific APIs✅ Semantic
  correctness - container and text make sense for terminals

  Perfect solution! We get the DOM structure and APIs without any of the web-specific complexity. 🎯


